; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://fmod_banks/Desktop"
DSP/dsp_buffer_size=1024
"3D Settings/distance_factor"=64.0

[addons]

ss2d/version="3.3.0"

[application]

config/name="SibJam2025"
config/tags=PackedStringArray("2d", "platformer")
run/main_scene="res://world.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="uid://dhwlmcglmf0kw"

[autoload]

GUIDE="*res://addons/guide/guide.gd"
EventBus="*res://globals/event_bus.gd"
GroupNames="*res://globals/group_names.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
MusicManager="res://systems/audio_system/music_manager.gd"
AudioPlayer="*res://audio_player.tscn"

[debug]

settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Example"

[editor]

movie_writer/node_name_casing=0

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotAnnotate/plugin.cfg", "res://addons/godot_mcp/plugin.cfg", "res://addons/guide/plugin.cfg", "res://addons/jamcountdown/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[global_group]

environment=""
Player=""
cell=""

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies/Hazards"
2d_physics/layer_4="DamageDealer (Hitbox)"
2d_physics/layer_5="DamageReceiver (Hurtbox)"
2d_physics/layer_6="Movable"
2d_physics/layer_7="Latch"
2d_physics/layer_11="Interactable"
2d_physics/layer_12="InteractableSensor"
2d_rendering/layer_1="world"
2d_rendering/layer_2="player_elements"
2d_rendering/layer_3="echo_light"
2d_rendering/layer_4="reveal_light"

[physics]

common/physics_interpolation=true
common/physics_interpolation/enable=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0.0019724718, 0.058017567, 1)
2d/snap/snap_2d_transforms_to_pixel=true
